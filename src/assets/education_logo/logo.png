#b_header .b_scopebar #fltIdtCon { display: block; }

#fltIdtCon span.ftrBRF { float: none; vertical-align: middle; }

#fltIdtCon ul.ftrUl { margin-left: 0px; overflow: visible; height: auto; }

#fltIdtCon li.ftrLi { display: block; line-height: normal; margin: 0px; pad=
ding: 0px; border: 0px; }

#fltIdtCon .ftrDC.hidden { display: none; }

#fltIdtCon span#fltIdt { vertical-align: middle; display: inline-block; }

span#fltIdtLnk { display: inline-block; line-height: 18px; cursor: pointer;=
 padding: 0 var(--smtc-padding-ctrl-sm-horizontal-default); color: var(--sm=
tc-foreground-content-neutral-primary); }

#fltIdtCon span#fltIdt:only-child a#fltIdtLnk { margin-top: var(--smtc-gap-=
between-content-xxx-small); }

#fltIdtLnk .fltIdtTit { display: inline-block; padding: 0 var(--smtc-paddin=
g-ctrl-sm-horizontal-default); vertical-align: 1px; }

#fltIdtLnk div.rms_iac, #fltIdtLnk img { display: inline-block; width: 16px=
; height: 14px; }

#fltIdtLnk img.fltFillIco, #fltIdtLnk .rms_iac[data-class~=3D"fltFillIco"],=
 .hasSel #fltIdtLnk img.fltIco, .hasSel #fltIdtLnk .rms_iac[data-class~=3D"=
fltIco"] { display: none; }

.hasSel #fltIdtLnk img.fltFillIco { display: inline-block; }

#fltIdtCon .ftrD_MmVert > a, #fltIdtCon .ftrD_MmVert > .ftrSe { padding: 0 =
var(--smtc-padding-ctrl-md-horizontal-default); }

#miniheader_scope #fltIdtCon { display: none; }

#ftr_pane #ftrB { margin-bottom: 0px; }

#rfPaneIn { margin-top: 0px; transition: margin 0.3s ease-in-out; }

.shwFltBar #rfPaneIn { margin-top: calc(-1*var(--smtc-gap-between-content-s=
mall)); }

.shwFltBar #rfPaneIn:empty { margin-top: 0px; }

@media screen and (max-width: 800px) {
  #b_header .b_scopebar ul > li:nth-child(n+5) { display: none; }
}

ul.subhead { margin-left: 0px; }
