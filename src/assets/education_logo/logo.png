.carousel-content { display: inline-block; float: left; width: 100%; }

.carousel-content .carousel-scroll-content.carousel_scroll { overflow-x: sc=
roll; }

.carousel-scroll-content, .carousel-scroll-wrapper { overflow: hidden; }

.carousel-scroll-content { position: relative; }

#ent-car-exp .carousel-scroll-content.clear-init-position { margin-left: 0p=
x; }

.default-scroll .carousel-scroll-content { overflow-x: scroll; padding-bott=
om: 10px; }

.item-carousel-title { display: none; }

.carousel .items { white-space: nowrap; float: left; }

.carousel .item { display: inline-block; vertical-align: top; }

.carousel .item .card { display: inline-block; vertical-align: top; }

.b_dark .carousel .item .card a:focus-visible { outline: 0px; }

.carousel .item .card a:focus { border-color: transparent; }

.carousel .pager-wrapper { overflow: hidden; }

.carDec { display: inline-block; padding-left: 6px; }

.car-cat-sep, .car-cat-txt { margin-left: 5px; vertical-align: bottom; disp=
lay: inline-block; }

.selCardBorder { display: none; }

.carousel-alert-banner { display: block; background-color: rgb(200, 0, 0); =
border-radius: 4px; padding: 5px 10px; margin-top: 10px; margin-bottom: 10p=
x; }

.carousel-alert-text { color: rgb(255, 255, 255); font-weight: bold; }

.car_dis .banLi { padding: 12px 0px; }

.car_dis .banLi > span { margin-bottom: 0px; }

.carousel-content.hasDis { margin-top: -20px; }

.covid_warning { border: 1px hidden rgb(221, 221, 221); border-radius: 4px;=
 padding: 12px 20px 12px 0px; width: 0px; }

.covid_warning_button { background-color: rgb(200, 0, 0); border: 1px solid=
 rgb(200, 0, 0); border-radius: 12px; padding: 4px 6px; font-family: var(--=
bing-smtc-text-style-default-regular-font-family); color: rgb(255, 255, 255=
); font-style: normal; font-weight: normal; font-size: 13px; line-height: 1=
6px; margin-right: 11px; float: left; cursor: pointer; }

.covid_warning_button_text { margin-left: 5px; }

.covid_warning_text { margin-top: 5px; }

#inline_ep .carousel-controls { height: 200px; }

#inline_ep .carousel-scroll-content { margin-left: 0px; }

#inline_ep .items, #inline_ep .car_anL { padding: 0px; }

#inline_ep .car_anL { padding-bottom: 10px; }

#inline_ep .carousel-attr, #inline_ep .noRes { padding-left: 0px; }

#inline_ep .item { margin-right: 12px; }

#inline_ep .item .card { width: 120px; margin: 2px 0px; }

#inline_ep .item .card { height: 171px; }

#inline_ep.carousel .nav_container { top: 50%; border-radius: 50%; margin: =
-28px 20px 0px; }

#inline_ep .nav_left, #inline_ep .nav_right { height: 56px; width: 56px; bo=
ttom: 72px; }

#inline_ep ol.items li:first-of-type .card { margin-left: 2px; }

.carousel .lightcar .nav_container > span.carouselChevron { width: 48px; he=
ight: 48px; margin: 4px; box-shadow: rgba(0, 0, 0, 0.25) 0px 8px 6px 2px; }

.carousel .lightcar .nav_container:hover > span.carouselChevron { width: 56=
px; height: 56px; margin: 0px; box-shadow: rgba(0, 0, 0, 0.15) 0px 13px 10p=
x 2px; }

.carousel .lightcar .nav_container:active > span.carouselChevron { width: 5=
2px; height: 52px; margin: 2px; box-shadow: rgba(0, 0, 0, 0.3) 0px 2px 6px =
2px; }

.carouselChevron { display: block; border-radius: 50%; background-repeat: n=
o-repeat; width: 48px; height: 48px; margin: 4px; }

.carousel .nav_container > span.carouselChevron { width: 48px; height: 48px=
; margin: 2px; box-shadow: rgba(0, 0, 0, 0.02) 0px 0px 0px 1px, rgba(0, 0, =
0, 0.25) 0px 8px 6px 2px; }

.carousel .nav_container:hover > span.carouselChevron { width: 52px; height=
: 52px; margin: 0px; box-shadow: rgba(0, 0, 0, 0.02) 0px 0px 0px 1px, rgba(=
0, 0, 0, 0.15) 0px 13px 10px 2px; }

.carousel .nav_container:active > span.carouselChevron { width: 52px; heigh=
t: 52px; margin: 0px; box-shadow: rgba(0, 0, 0, 0.3) 0px 2px 6px 2px; }

.carousel .nav_right_hint { display: none; }

.nav_container:hover .nav_right_hint { display: block; margin: -26px 0px 0p=
x; padding: 16px 63px 16px 16px; color: rgb(17, 17, 17); white-space: nowra=
p; font-size: 16px; line-height: 22px; top: 48%; right: 1px; position: abso=
lute; background-color: rgb(245, 245, 245); border-radius: 56px; z-index: -=
